+def is_qualified_transaction_identifier_bridge(
+    attr_a: str,
+    attr_b: str,
+    decision: Dict[str, Any]
+) -> bool:
+    """
+    Determines if a cross-context merge is a qualified transaction identifier bridge.
+
+    A qualified bridge is a narrow exception where both attributes are transaction identifier
+    subtypes (e.g., identifier:transaction, identifier:upi_transaction) merged under a
+    transaction_identifier canonical node. This does NOT make the pair context-safe in the
+    strict C4 sense, but allows C4 to report PARTIALLY_SUPPORTED with explicit transparency.
+
+    Criteria (all must hold):
+      - Both semantic families start with "identifier:" and contain "transaction" subtype
+      - Canonical node is "transaction_identifier"
+      - Both roles contain "transaction" and "identifier"
+      - Decision was ACCEPT_MERGE
+      - No hard veto rules violated
+
+    Excludes high-risk identifiers: payer, payee, debtor, creditor, customer, account,
+    routing, VPA, PAN, card, order, message, intent, end_to_end, STAN, bank account number.
+
+    Args:
+        attr_a: First attribute slug (e.g., "Plaid.transaction_id")
+        attr_b: Second attribute slug (e.g., "UPI.txn_id")
+        decision: Decision dict with keys: Action, CanonicalNode, FamilyA, FamilyB, RoleA, RoleB
+
+    Returns:
+        True if qualified transaction identifier bridge, False otherwise
+    """
+    if decision.get("Action") != "ACCEPT_MERGE":
+        return False
+
+    canonical = decision.get("CanonicalNode", "").lower()
+    if canonical != "transaction_identifier":
+        return False
+
+    family_a = decision.get("FamilyA", "").lower()
+    family_b = decision.get("FamilyB", "").lower()
+
+    # Both must be identifier: family with transaction subtype
+    if not (family_a.startswith("identifier:") and "transaction" in family_a):
+        return False
+    if not (family_b.startswith("identifier:") and "transaction" in family_b):
+        return False
+
+    role_a = decision.get("RoleA", "").lower()
+    role_b = decision.get("RoleB", "").lower()
+
+    # Both roles must contain transaction and identifier
+    if not ("transaction" in role_a and "identifier" in role_a):
+        return False
+    if not ("transaction" in role_b and "identifier" in role_b):
+        return False
+
+    # Exclude high-risk role-sensitive identifiers
+    excluded_keywords = [
+        "payer", "payee", "debtor", "creditor", "customer", "account",
+        "routing", "vpa", "pan", "card", "order", "message", "intent",
+        "end_to_end", "stan", "bank"
+    ]
+    combined_text = f"{attr_a} {attr_b} {role_a} {role_b} {family_a} {family_b}".lower()
+    for kw in excluded_keywords:
+        if kw in combined_text:
+            return False
+
+    return True
+
+
+def deduplicate_predicted_pairs_v18_1(decisions: List[Dict[str, Any]]) -> Dict[str, Any]:
+    """
+    Deduplicates predicted alias pairs for metric computation.
+
+    Raw accepted decisions may contain production/discovery duplicates (same pair discovered
+    multiple times). Metrics (TP/FP/FN) must be computed from the unique canonical pair set,
+    while duplicate raw audit-track entries are retained for lineage explainability.
+
+    Returns dict with:
+      - raw_pairs: List[Tuple[str, str]] - all ACCEPT_MERGE pairs in stable order
+      - unique_pairs: Set[Tuple[str, str]] - deduplicated canonical pairs (no self-pairs)
+      - duplicate_audit: Dict with counts, examples, policy explanation
+    """
+    from collections import Counter
+
+    raw_pairs = []
+    for dec in decisions:
+        if dec.get("Action") == "ACCEPT_MERGE":
+            a = dec.get("AttributeA", "").strip()
+            b = dec.get("AttributeB", "").strip()
+            if a and b and a != b:
+                pair = tuple(sorted([a, b]))
+                raw_pairs.append(pair)
+
+    unique_pairs = set(raw_pairs)
+    pair_counts = Counter(raw_pairs)
+    duplicates = {pair: count for pair, count in pair_counts.items() if count > 1}
+
+    duplicate_audit = {
+        "detected": len(duplicates) > 0,
+        "count": len(duplicates),
+        "total_raw_duplicates": sum(count - 1 for count in duplicates.values()),
+        "examples": [f"{a}::{b} (×{count})" for (a, b), count in list(duplicates.items())[:3]],
+        "policy": "Metrics are computed from deduplicated canonical pairs; duplicate production/discovery audit tracks are retained only for lineage explainability."
+    }
+
+    return {
+        "raw_pairs": raw_pairs,
+        "unique_pairs": unique_pairs,
+        "duplicate_audit": duplicate_audit
+    }
+
