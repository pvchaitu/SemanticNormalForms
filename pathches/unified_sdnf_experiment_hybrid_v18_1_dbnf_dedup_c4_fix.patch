+def determine_c4_status(
+    decisions: List[Dict[str, Any]],
+    unique_predicted_pairs: Set[Tuple[str, str]]
+) -> Tuple[str, Dict[str, Any]]:
+    """
+    Determines C4 context safety status with qualified transaction identifier bridge support.
+
+    Returns:
+        Tuple of (status, evidence_dict)
+        status: "SUPPORTED" | "PARTIALLY_SUPPORTED" | "NOT_SUPPORTED"
+        evidence_dict: detailed counts, examples, and qualification policy
+    """
+    cross_context_merges = []
+    qualified_bridges = []
+    unsafe_merges = []
+
+    for dec in decisions:
+        if dec.get("Action") != "ACCEPT_MERGE":
+            continue
+
+        a = dec.get("AttributeA", "").strip()
+        b = dec.get("AttributeB", "").strip()
+        if not a or not b or a == b:
+            continue
+
+        pair = tuple(sorted([a, b]))
+        if pair not in unique_predicted_pairs:
+            continue
+
+        family_a = dec.get("FamilyA", "").lower()
+        family_b = dec.get("FamilyB", "").lower()
+
+        # Cross-context if families differ (ignoring subtype suffix after colon)
+        base_family_a = family_a.split(":")[0] if ":" in family_a else family_a
+        base_family_b = family_b.split(":")[0] if ":" in family_b else family_b
+
+        if base_family_a != base_family_b:
+            cross_context_merges.append((a, b, dec))
+            if is_qualified_transaction_identifier_bridge(a, b, dec):
+                qualified_bridges.append((a, b, dec))
+            else:
+                unsafe_merges.append((a, b, dec))
+
+    if len(unsafe_merges) > 0:
+        status = "NOT_SUPPORTED"
+    elif len(qualified_bridges) > 0:
+        status = "PARTIALLY_SUPPORTED"
+    else:
+        status = "SUPPORTED"
+
+    evidence = {
+        "accepted_merge_count": len(unique_predicted_pairs),
+        "raw_cross_context_merge_count": len(cross_context_merges),
+        "unsafe_cross_context_merge_count": len(unsafe_merges),
+        "qualified_context_bridge_count": len(qualified_bridges),
+        "qualified_context_bridge_examples": [f"{a}::{b}" for a, b, _ in qualified_bridges[:3]],
+        "unsafe_cross_context_examples": [f"{a}::{b}" for a, b, _ in unsafe_merges[:3]],
+        "context_safety_policy": "Qualified transaction identifier bridges (e.g., Plaid.transaction_id::UPI.txn_id) are classified separately from unsafe cross-context merges; C4 is PARTIALLY_SUPPORTED when only qualified bridges exist, pending explicit CMNF matrix policy or reviewer-approved ground truth."
+    }
+
+    return status, evidence
+
