+def expand_pairs_within_nodes(nodes: Dict[str, CanonicalNode], use_names: bool = True) -> Set[Pair]:
+    """Generate full pairwise closure within each canonical node.
+
+    This is used ONLY for the lexicon-quality evaluation view.
+    It does not change decisions_audit or strict ACCEPT_MERGE edges.
+
+    Args:
+        nodes: canonical node map
+        use_names: if True, generate pairs in attribute.name space; else provider_field space
+
+    Returns:
+        Set of Pair objects representing the full intra-cluster closure.
+    """
+    out: Set[Pair] = set()
+    for node in nodes.values():
+        members = node.members
+        if len(members) < 2:
+            continue
+        for i in range(len(members)):
+            for j in range(i + 1, len(members)):
+                a = members[i].name if use_names else members[i].provider_field
+                b = members[j].name if use_names else members[j].provider_field
+                p = Pair.make(a, b)
+                if p.a != p.b:
+                    out.add(p)
+    return out
+
