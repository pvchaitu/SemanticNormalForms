+class LearnedLexicon:
+    """Domain-independent lexicon learned from schema descriptors."""
+
+    def __init__(self) -> None:
+        self.prefixes: Set[str] = set()
+        self.abbrev_map: Dict[str, str] = {}
+        self.representative_map: Dict[str, str] = {}
+        self.schema_fingerprint: str = ""
+
+    @staticmethod
+    def _compute_schema_fingerprint(descs: List["SchemaDescriptor"]) -> str:
+        parts = []
+        for d in sorted(descs, key=lambda x: x.schema_id):
+            parts.append(f"{d.schema_id}:{d.schema_descriptor_version}:{len(d.attributes)}")
+        return hashlib.sha256("|".join(parts).encode()).hexdigest()[:16]
+
+    # ── phase 1: learn prefixes ──────────────────────────────────────────
+    def learn_prefixes_from_schemas(self, descs: List["SchemaDescriptor"]) -> Set[str]:
+        provider_tokens: Set[str] = set()
+        for d in descs:
+            for source in [Path(d.path).stem.replace(".schema", ""), d.schema_id, d.provider]:
+                for tok in re.split(r"[_\-.\ s/]+", source.lower()):
+                    if tok and len(tok) >= 2:
+                        provider_tokens.add(tok)
+        noise = frozenset({"schema", "payment", "card", "account", "transaction", "api",
+                           "object", "entity", "descriptor", "payload", "inferred", "like",
+                           "style", "generic", "the", "and", "for", "with", "from", "plus",
+                           "v1", "v2", "v15", "v16", "v17", "v18"})
+        provider_tokens -= noise
+        all_names = [a.name.lower() for d in descs for a in d.attributes]
+        confirmed: Set[str] = set()
+        for tok in provider_tokens:
+            pfx = tok + "_"
+            if sum(1 for n in all_names if n.startswith(pfx) and len(n) > len(pfx)) >= 1:
+                confirmed.add(pfx)
+        self.prefixes = confirmed
+        return confirmed
+
+    # ── phase 2: learn abbreviations ─────────────────────────────────────
+    def learn_abbrev_from_aliases(self, descs: List["SchemaDescriptor"]) -> Dict[str, str]:
+        candidates: Dict[str, Dict[str, int]] = defaultdict(lambda: defaultdict(int))
+        token_families: Dict[str, Set[str]] = defaultdict(set)
+        for d in descs:
+            for a in d.attributes:
+                ns = slug(a.name)
+                canon = slug(a.canonical_hint) if a.canonical_hint else ""
+                family = a.semantic_family or ""
+                forms = list({f for f in [ns] + [slug(x) for x in a.aliases] + ([canon] if canon else []) if f})
+                for f in forms:
+                    token_families[f].add(family)
+                for i, fa in enumerate(forms):
+                    for fb in forms[i + 1:]:
+                        if fa == fb:
+                            continue
+                        short, long_ = (fa, fb) if len(fa) < len(fb) else (fb, fa)
+                        if len(short) <= 1 or short in GENERIC_TOKENS_GUARD:
+                            continue
+                        candidates[short][long_] += 1
+                name_toks = set(ns.split("_"))
+                for al in a.aliases:
+                    al_s = slug(al)
+                    al_toks = set(al_s.split("_"))
+                    if name_toks & al_toks and name_toks != al_toks:
+                        short, long_ = (al_s, ns) if len(al_s) < len(ns) else (ns, al_s)
+                        if short not in GENERIC_TOKENS_GUARD and len(short) > 1:
+                            candidates[short][long_] += 1
+        abbrev: Dict[str, str] = {}
+        for short, longs in candidates.items():
+            best = max(longs, key=longs.get)
+            needed = 3 if short in GENERIC_TOKENS_GUARD else 1
+            if longs[best] >= needed:
+                if short in GENERIC_TOKENS_GUARD:
+                    if not (token_families.get(short, set()) & token_families.get(best, set())):
+                        continue
+                abbrev[short] = best
+        self.abbrev_map = abbrev
+        return abbrev
+
+    # ── phase 3: equivalence classes ─────────────────────────────────────
+    def build_equivalence_classes(self, descs: List["SchemaDescriptor"]) -> Dict[str, str]:
+        uf = _UnionFind()
+        token_meta: Dict[str, Dict[str, Any]] = {}
+        canon_groups: Dict[str, Set[str]] = defaultdict(set)
+        for d in descs:
+            for a in d.attributes:
+                canon = slug(a.canonical_hint) if a.canonical_hint else ""
+                family, role = a.semantic_family or "", a.role or ""
+                ns = slug(a.name)
+                forms: Set[str] = {ns}
+                for al in a.aliases:
+                    al_s = slug(al)
+                    if al_s:
+                        forms.add(al_s)
+                if canon:
+                    forms.add(canon)
+                for f in list(forms):
+                    for pfx in self.prefixes:
+                        if f.startswith(pfx) and len(f) > len(pfx):
+                            forms.add(f[len(pfx):])
+                for f in list(forms):
+                    if f in self.abbrev_map:
+                        forms.add(self.abbrev_map[f])
+                for f in forms:
+                    if f not in token_meta:
+                        token_meta[f] = {"families": set(), "roles": set(), "canons": set()}
+                    token_meta[f]["families"].add(family)
+                    token_meta[f]["roles"].add(role)
+                    if canon:
+                        token_meta[f]["canons"].add(canon)
+                if canon:
+                    for f in forms:
+                        canon_groups[canon].add(f)
+        for canon, members in canon_groups.items():
+            ml = sorted(members)
+            for i, t1 in enumerate(ml):
+                for t2 in ml[i + 1:]:
+                    if _hierarchy_conflict(t1, t2):
+                        continue
+                    if _role_conflict_check(t1, t2, token_meta):
+                        continue
+                    uf.union(t1, t2)
+        fam_groups: Dict[str, Set[str]] = defaultdict(set)
+        for tok, meta in token_meta.items():
+            if not meta["canons"]:
+                for fam in meta["families"]:
+                    if fam and fam != "unknown":
+                        fam_groups[fam].add(tok)
+        for fam, tokens in fam_groups.items():
+            tl = sorted(tokens)
+            for i, t1 in enumerate(tl):
+                for t2 in tl[i + 1:]:
+                    if _hierarchy_conflict(t1, t2):
+                        continue
+                    if _role_conflict_check(t1, t2, token_meta):
+                        continue
+                    uf.union(t1, t2)
+        groups = uf.groups()
+        rep: Dict[str, str] = {}
+        for root, members in groups.items():
+            best = root
+            for m in sorted(members):
+                mc = token_meta.get(m, {}).get("canons", set())
+                if mc:
+                    best = sorted(mc)[0]
+                    break
+            for m in members:
+                rep[m] = best
+        self.representative_map = rep
+        return rep
+
+    # ── runtime helpers ──────────────────────────────────────────────────
+    def normalize_token(self, t: str) -> str:
+        t = slug(t)
+        for pfx in sorted(self.prefixes, key=len, reverse=True):
+            if t.startswith(pfx) and len(t) > len(pfx):
+                t = t[len(pfx):]
+                break
+        if t in self.abbrev_map:
+            t = self.abbrev_map[t]
+        if t in self.representative_map:
+            t = self.representative_map[t]
+        return t
+
+    def same_equivalence_class(self, a: str, b: str) -> bool:
+        return self.normalize_token(a) == self.normalize_token(b)
+
+    def learn_from_schemas(self, descs: List["SchemaDescriptor"]) -> None:
+        self.schema_fingerprint = self._compute_schema_fingerprint(descs)
+        self.learn_prefixes_from_schemas(descs)
+        self.learn_abbrev_from_aliases(descs)
+        self.build_equivalence_classes(descs)
+
+    def save(self, path: Path) -> None:
+        data = {"schema_fingerprint": self.schema_fingerprint,
+                "prefixes": sorted(self.prefixes),
+                "abbrev_map": self.abbrev_map,
+                "representative_map": self.representative_map}
+        with path.open("w", encoding="utf-8") as f:
+            json.dump(data, f, indent=2, ensure_ascii=False, sort_keys=True)
+
+    def load(self, path: Path, expected_fingerprint: str) -> bool:
+        if not path.exists():
+            return False
+        try:
+            with path.open("r", encoding="utf-8") as f:
+                data = json.load(f)
+            if data.get("schema_fingerprint") != expected_fingerprint:
+                return False
+            self.schema_fingerprint = data["schema_fingerprint"]
+            self.prefixes = set(data.get("prefixes", []))
+            self.abbrev_map = data.get("abbrev_map", {})
+            self.representative_map = data.get("representative_map", {})
+            return True
+        except Exception:
+            return False
+
+    def summary(self) -> Dict[str, Any]:
+        return {"schema_fingerprint": self.schema_fingerprint,
+                "learned_prefix_count": len(self.prefixes),
+                "learned_prefixes": sorted(self.prefixes),
+                "learned_abbrev_count": len(self.abbrev_map),
+                "equivalence_class_count": len(set(self.representative_map.values())),
+                "total_tokens_mapped": len(self.representative_map)}
 
 
