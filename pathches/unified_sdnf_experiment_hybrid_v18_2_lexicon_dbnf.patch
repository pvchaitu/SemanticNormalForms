+class _UnionFind:
+    """Minimal disjoint-set / union-find for equivalence class construction."""
+    def __init__(self):
+        self._parent: Dict[str, str] = {}
+        self._rank: Dict[str, int] = {}
+
+    def find(self, x: str) -> str:
+        if x not in self._parent:
+            self._parent[x] = x
+            self._rank[x] = 0
+        root = x
+        while self._parent[root] != root:
+            root = self._parent[root]
+        while self._parent[x] != root:
+            self._parent[x], x = root, self._parent[x]
+        return root
+
+    def union(self, a: str, b: str) -> None:
+        ra, rb = self.find(a), self.find(b)
+        if ra == rb:
+            return
+        if self._rank[ra] < self._rank[rb]:
+            ra, rb = rb, ra
+        self._parent[rb] = ra
+        if self._rank[ra] == self._rank[rb]:
+            self._rank[ra] += 1
+
+    def groups(self) -> Dict[str, Set[str]]:
+        result: Dict[str, Set[str]] = defaultdict(set)
+        for x in self._parent:
+            result[self.find(x)].add(x)
+        return dict(result)
+
+
+GENERIC_TOKENS_GUARD = frozenset({"id", "type", "name", "status", "date", "time", "code", "value"})
+
+
+def _hierarchy_conflict(t1: str, t2: str) -> bool:
+    """Return True if merging t1 and t2 would collapse a type/subtype hierarchy."""
+    p1, p2 = set(t1.split("_")), set(t2.split("_"))
+    if ("subtype" in p1) != ("subtype" in p2):
+        return True
+    if t1 == "type" and t2 != "type" and "type" in p2:
+        return True
+    if t2 == "type" and t1 != "type" and "type" in p1:
+        return True
+    return False
+
+
+def _role_conflict_check(t1: str, t2: str, token_meta: Dict[str, Dict[str, Any]]) -> bool:
+    """Return True if two tokens carry conflicting roles (payer/payee etc.)."""
+    roles1 = token_meta.get(t1, {}).get("roles", set())
+    roles2 = token_meta.get(t2, {}).get("roles", set())
+    for r1 in roles1:
+        for r2 in roles2:
+            r1t = set(r1.lower().replace("_", " ").split())
+            r2t = set(r2.lower().replace("_", " ").split())
+            for ca, cb in ROLE_CONFLICTS:
+                if ca in r1t and cb in r2t:
+                    return True
+    return False
+
